#!/usr/bin/env bash
# The test gate. Runs the full checks and exits non-zero on any red. This is
# the mechanical gate that must pass before code reaches main — telling a
# session to "run the tests" is an instruction it can optimise past; a gate
# it cannot. `./plan publish` runs it before merging and refuses on failure.
#
# Three gates, cheap to expensive: lint, unit tests, production build. The
# build is a real gate here, not a nicety — CI runs this gate on every push to
# main (.github/workflows/deploy.yml), and `./server/deploy` ships the build, so a
# main that doesn't build can't ship.
#
# The bypass is one explicit, echoed env flag, mirroring the handoff hook's
# HANDOFF=1: WORKOUT_SKIP_CHECK=1 skips the checks and says so loudly on
# stderr. There is NO quiet default — a skip is always a visible choice.
#
# A gate can't be narrowed from the command line: arguments are ignored and
# the full gate always runs (so `./check clean` runs the gate, it doesn't
# error). The one argument it reads WIDENS it: `--smoke` (req-159) adds the
# headless browser smoke test (scripts/smoke.mjs — the core loop by real clicks
# on an isolated build of HEAD, ~5s). Off by default so every ./check stays
# fast; CI always runs it.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# req-249 (L-065) — first thing: the node on PATH must meet server/config.mjs's NODE_FLOOR (one
# source, req-235). Below it, node:sqlite has no online `backup` and 7 server tests go red for a
# reason that has nothing to do with the code (10-30: nvm's default 22.14 under `plan publish`).
# Compared on `node --version`'s text, so the message names exactly the node that would run.
nodever="$(node --version 2>/dev/null)" || { echo "check: no node on PATH — run: nvm use" >&2; exit 1; }
if ! floor="$(node --input-type=module -e "import { NODE_FLOOR_TEXT, nodeVersionOk } from '$HERE/server/config.mjs'; console.log(NODE_FLOOR_TEXT); process.exit(nodeVersionOk(process.argv[1]) ? 0 : 1)" "$nodever")"; then
  echo "check: node $nodever < floor v${floor:-? (server/config.mjs unreadable)} — run: nvm use" >&2
  exit 1
fi

if [ -n "${WORKOUT_SKIP_CHECK:-}" ]; then
  echo "check: SKIPPED — nothing was run (WORKOUT_SKIP_CHECK=$WORKOUT_SKIP_CHECK)" >&2
  echo "check: explicit bypass of the gate; main is unverified." >&2
  exit 0
fi

smoke=""
ignored=()
for arg in "$@"; do
  if [ "$arg" = "--smoke" ]; then smoke=1; else ignored+=("$arg"); fi
done
if [ "${#ignored[@]}" -gt 0 ]; then
  echo "check: ignoring arguments (${ignored[*]}) — the gate always runs the full set." >&2
fi

cd "$HERE"

# A gate that runs zero tests and passes is worse than no gate. Refuse if the
# search finds nothing rather than letting node --test exit 0 on an empty run.
#
# `find` rather than a bash glob (req-34): the gate must run EVERY *.test.js
# under src/, nested folders included (e.g. src/views/history/). A top-level
# `src/*.test.js` glob skips those silently, and `src/**/*.test.js` needs
# globstar — unavailable in the bash 3.2 this runs under on macOS. `find`
# recurses portably on both macOS and the Ubuntu CI runner.
#
# req-229: the server's tests (server/**/*.test.mjs, temp DBs only — BACKEND rule 8) run in
# the same `node --test` call. Each side must find at least one file, so a moved folder
# can't silently drop half the suite.
testfiles=()
while IFS= read -r f; do
  testfiles+=("$f")
done < <(find src -type f -name '*.test.js' | sort)
if [ "${#testfiles[@]}" -eq 0 ]; then
  echo "check: RED — no test files matched src/**/*.test.js; refusing." >&2
  echo "check: a gate that runs nothing must not pass. Check the path." >&2
  exit 5
fi
servertests=0
while IFS= read -r f; do
  testfiles+=("$f")
  servertests=$((servertests + 1))
done < <(find server -type f -name '*.test.mjs' | sort)
if [ "$servertests" -eq 0 ]; then
  echo "check: RED — no test files matched server/**/*.test.mjs; refusing." >&2
  exit 5
fi

fail() {
  echo "check: RED — $1 failed; refusing." >&2
  echo "check: fix it, or bypass explicitly with WORKOUT_SKIP_CHECK=1." >&2
  exit 1
}

# 1. Lint (oxlint) — fast, catches the rules-of-hooks / dead-export class.
echo "check: linting (oxlint)…"
npm run --silent lint || fail "lint (oxlint)"

# 1b. Skills (req-162, from req-160): every .claude/skills pointer (path, L-/DEC- id,
# §section) still resolves, and no rule text is copied into a skill — so renaming a
# rule section or retiring an entry breaks here, loudly, not silently in a skill.
echo "check: skills (check_skills.py)…"
python3 scripts/check_skills.py >/dev/null || { python3 scripts/check_skills.py >&2 || true; fail "the skills check (scripts/check_skills.py)"; }

# 1c. Import cycles (req-166, from req-164): scripts/check-cycles.mjs lists every static
# import cycle among src/ modules; one fails the gate (model ↔ workout-log was broken in
# req-164 and must stay broken).
echo "check: import cycles (check-cycles.mjs)…"
node scripts/check-cycles.mjs >/dev/null || { node scripts/check-cycles.mjs >&2 || true; fail "the import-cycle check (scripts/check-cycles.mjs)"; }

# 2. Unit tests (node --test) — the behaviour gate.
echo "check: running ${#testfiles[@]} test file(s) (node --test)…"
# req-229 review round 1: the live-data-path guard (BACKEND rule 8, server/config.mjs) is on for
# the whole run, not only for test files that import server/test-helpers.mjs.
# req-248 (from req-239's mutation check): a hanging test must turn the gate red, not hang it
# (and `plan publish` / CI with it). --test-timeout cancels any test or hook still running after
# 60 s (measured 2026-10-26: slowest test 5.2 s local / 2.9 s CI, slowest hook — builds.test.js's
# two vite builds — 1.3 s; a loaded Mac ran the suite ~3x slower (288 s vs 80–105 s), so ~15.7 s,
# and ~3x that again, rounded up — a busy machine must not turn the gate red at random).
# The same 60 s also bounds each test FILE: the runner kills a file's process still alive then
# (node 22.23, measured 2026-10-31), so a test that left a timer or socket open turns red, named.
# req-266 (L-067): no --test-force-exit. It ended each file's process with process.exit() the moment
# its tests finished, while the results were still queued on the stdout pipe to the runner (pipe
# writes are async on POSIX): a random file lost its last tests with no ✖, exit 0 (2171–2187 tests
# across 10 runs of one tree). A file now exits on its own, after its output is written — so a
# test must not leave a handle open (src/test-support/long-timers.js for the download's timer).
# None of this fires on a SYNCHRONOUS hang (req-239's mutation: a render loop, the file's process at
# 100%+ CPU, so no in-process timer ever runs). The watchdog below bounds the whole step from
# outside: past the limit it names the still-running test files and kills them. 900 s is ~3x the
# slowest full run measured (288 s, local under load; CI ~96 s). WORKOUT_TEST_LIMIT overrides it,
# loudly (used to prove the watchdog fires without waiting 15 min).
limit=900
if [ -n "${WORKOUT_TEST_LIMIT:-}" ]; then
  limit="$WORKOUT_TEST_LIMIT"
  echo "check: test-suite limit overridden to ${limit}s (WORKOUT_TEST_LIMIT)" >&2
fi
# req-258: a second reporter writes TAP to a temp file, read after a green run (below). The
# terminal reporter stays what node picks today: spec on a TTY, tap off one (Node 22, CI).
tapfile="$(mktemp "${TMPDIR:-/tmp}/workout-check-tap.XXXXXX")"
trap 'rm -f "$tapfile"' EXIT
if [ -t 1 ]; then termreporter=spec; else termreporter=tap; fi
WORKOUT_SERVER_TEST=1 node --test --test-timeout=60000 \
  --test-reporter="$termreporter" --test-reporter-destination=stdout \
  --test-reporter=tap --test-reporter-destination="$tapfile" \
  "${testfiles[@]}" &
testpid=$!
(
  waited=0
  while kill -0 "$testpid" 2>/dev/null; do
    if [ "$waited" -ge "$limit" ]; then
      echo "check: the test suite is still running after ${limit}s — a hung test. Still running:" >&2
      pgrep -P "$testpid" | while read -r child; do
        ps -o command= -p "$child" | awk '{ print "check:   " $NF }' >&2
      done
      pkill -TERM -P "$testpid" 2>/dev/null || true
      kill -TERM "$testpid" 2>/dev/null || true
      sleep 5
      pkill -KILL -P "$testpid" 2>/dev/null || true
      kill -KILL "$testpid" 2>/dev/null || true
      exit 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
) &
watchdog=$!
if wait "$testpid"; then teststatus=0; else teststatus=$?; fi
wait "$watchdog" || true
[ "$teststatus" -eq 0 ] || fail "the test suite"

# req-258 (L-045): green is not enough. A test file that exits before its tests run (e.g. a
# stray process.exit(0)) is reported by node as ONE passing test named after the file — a
# file-level `ok N - path.test.js` line — so its tests vanish with no ✖. No file may do that
# (none does on main, 2026-10-31). And a run with no `# tests N`, or N = 0, ran nothing.
emptyfiles="$(grep -E '^(not )?ok [0-9]+ - .*\.test\.m?js$' "$tapfile" | sed -E 's/^(not )?ok [0-9]+ - //' || true)"
if [ -n "$emptyfiles" ]; then
  while IFS= read -r f; do
    echo "check: RED — $f ran no tests (it exited before they ran)." >&2
  done <<< "$emptyfiles"
  fail "the test suite (a file ran no tests)"
fi
testcount="$(sed -nE 's/^# tests ([0-9]+)$/\1/p' "$tapfile" | tail -n 1)"
if [ -z "$testcount" ] || [ "$testcount" -eq 0 ]; then
  echo "check: RED — the test run reported ${testcount:-no} '# tests' count; nothing ran." >&2
  fail "the test suite (no tests ran)"
fi

# 3. Production build (vite) — main must stay deployable (`./server/deploy` builds it).
echo "check: building (vite build)…"
npm run --silent build >/dev/null || fail "the production build"

# 3b. req-275 (L-071): the six shell suites (scripts/*.test.sh — plan, check_handoff, the skills
# check, the pre-push hook) — only those whose subject this checkout changed vs main (diff from the
# merge base, plus the working tree): all six take ≈34 s against this gate's ≈9 s. CI runs all six
# on every push (.github/workflows/deploy.yml). The selection table is scripts/shell-suites.sh.
echo "check: shell suites for this change (scripts/shell-suites.sh --changed)…"
suites_out="$(bash scripts/shell-suites.sh --changed)" || { printf '%s\n' "$suites_out"; fail "a shell suite (scripts/shell-suites.sh)"; }
printf '%s\n' "$suites_out" | sed 's/^/check:   /'
suites_ran="$(printf '%s\n' "$suites_out" | sed -n 's/^shell suites: green — //p')"
suites_note="${suites_ran:+, the shell suites ($suites_ran)}"

# 4. (--smoke only) the browser smoke test — HEAD's committed tree, not the
# working copy (it builds from `git archive HEAD`).
if [ -n "$smoke" ]; then
  echo "check: smoke test (headless browser, HEAD)…"
  node scripts/smoke.mjs || fail "the smoke test"
  echo "check: green — lint, skills, no import cycles, ${testcount} test(s) in ${#testfiles[@]} file(s), the build${suites_note}, and the smoke test all passed."
  exit 0
fi

echo "check: green — lint, skills, no import cycles, ${testcount} test(s) in ${#testfiles[@]} file(s), and the build${suites_note} all passed."

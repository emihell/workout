#!/usr/bin/env bash
# One executable for the two-worktree workflow (req-06). Not a git frontend —
# anything this doesn't cover, use git directly.
set -euo pipefail

usage() {
  cat <<'EOF'
plan save "message"    commit handoff/ changes from the planning worktree
plan publish           merge planning into main, safely
plan status            where everything is, and what's unpublished
plan next              the single next command to run, and why
plan ping req-N        verify req-N's doc is on main AND planning is fully
                        published, then print a ready-to-paste handoff ping.
                        Read-only; refuses (pointing to publish) otherwise.
plan sync              both directions of staleness: unpublished planning
                        AND the planning worktree's own code falling behind
plan closeout req-N    merge a built branch, flip its doc status, publish,
                        push both branches, delete the branch — one command.
                        Refuses BEFORE merging when the diff touches a DEC-057
                        trigger file and the SHIPPED gate line names no reviewer;
                        override: --no-reviewer "<reason>" (recorded in SHIPPED)
plan preview [req-N]   build the checked-out (or a named req-N) branch and
                        serve it over Tailscale (HTTPS) to test on the phone
                        before merge; run in the CODE worktree (DEC-041)
plan preview stop      tear down that preview server + tailscale serve
plan qa <ref>          build any ref (git archive, no checkout) and serve it on a
                        free 127.0.0.1 port, seeded with src/db.json under the v8
                        key (--seed <file> to change). Read-only to both worktrees;
                        safe from either. (req-159)
plan qa --stop         stop it and delete its build   ·   plan qa --status
plan doctor            verify first-machine setup (layout, hooks, deps, grants,
                        git identity), then print status. Read-only; exits
                        non-zero if any check needs a fix.
EOF
}

# req-12: is a Claude Code session running at all? Not *whether it's mid-task*
# — there's no signal for that, and inventing one (a marker file) fails open
# the moment it's forgotten (L-014). This only answers the cheap, honest
# question: does a `claude` process exist.
#
# `-x` (exact process-name match) rather than `-f` (substring of the full
# command line) deliberately: an editor or wrapper can carry the word
# "claude" somewhere in its command line — an installed extension path,
# for instance — without a Claude Code session actually running, and `-f`
# would warn on that every time (req-12 criterion 6).
#
# Fails closed (L-014's correction, not its mistake): if the detection
# command is missing or errors, that's an unknown state, and unknown is not
# safe, so this returns "running" rather than "not running".
claude_code_running() {
  if ! command -v pgrep >/dev/null 2>&1; then
    return 0
  fi
  pgrep -x claude >/dev/null 2>&1
  case "$?" in
    0) return 0 ;;  # a claude process exists
    1) return 1 ;;  # cleanly: no match
    *) return 0 ;;  # pgrep itself errored — unknown, not safe
  esac
}

# req-91: `plan preview` state. Machine-local temp — one preview at a time on
# this Mac (the fixed demo port, DEC-041), so a single pidfile/log is enough.
PREVIEW_PORT=4173
PREVIEW_PIDFILE="${TMPDIR:-/tmp}/workout-plan-preview.pid"
PREVIEW_LOG="${TMPDIR:-/tmp}/workout-plan-preview.log"

# Sets PLANNING_DIR / CODE_DIR from `git worktree list`, keyed on branch name
# rather than a hardcoded path — req-02 may move things, Emilio may rename
# either checkout directory.
#
# req-129: a worktree NESTED inside another listed worktree (a throwaway build
# agent's, under `workout-codebase/.claude/worktrees/`) is never the code
# worktree, so it is skipped. Before this the last non-planning worktree listed
# won, and an agent's worktree on `req-120` made `plan publish` refuse ("code
# worktree is on 'req-120'"). Nesting is a path-prefix test against the other
# listed worktrees, so no directory name is hardcoded and the branch-keyed
# design holds.
worktree_is_nested() {
  local candidate="$1" other
  while IFS= read -r other; do
    [ -n "$other" ] && [ "$other" != "$candidate" ] || continue
    case "$candidate" in
      "$other"/*) return 0 ;;
    esac
  done <<<"$2"
  return 1
}

find_worktrees() {
  PLANNING_DIR=""
  CODE_DIR=""
  local path="" line all_paths
  all_paths="$(git worktree list --porcelain | sed -n 's/^worktree //p')"
  while IFS= read -r line; do
    case "$line" in
      worktree\ *)
        path="${line#worktree }"
        if worktree_is_nested "$path" "$all_paths"; then
          path=""
        fi
        ;;
      branch\ refs/heads/planning)
        [ -n "$path" ] && PLANNING_DIR="$path"
        ;;
      branch\ refs/heads/*)
        [ -n "$path" ] && CODE_DIR="$path"
        ;;
    esac
  done < <(git worktree list --porcelain)

  if [ -z "$PLANNING_DIR" ]; then
    echo "plan: no worktree is checked out on branch 'planning'" >&2
    exit 1
  fi
  if [ -z "$CODE_DIR" ]; then
    echo "plan: found the planning worktree but no second (code) worktree" >&2
    exit 1
  fi
}

# req-100 (R2): the NOW.md ≤N-line rule has ONE source of truth —
# NOW_MD_RULE_LIMIT in check_handoff.py. Read it at runtime rather than restating
# 50 here, so the guard can never disagree with the drift check. check_handoff
# imports cleanly (all its work is behind `__main__`).
now_md_limit() {
  python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import check_handoff; print(check_handoff.NOW_MD_RULE_LIMIT)' "$1"
}

# req-166 (L-014) — fetch origin first, then warn when a local branch is BEHIND its
# origin copy: a session that reasons from a stale local planning branch re-does work
# that already exists (L-014 lost a whole session to it). Never blocks and never prompts:
# offline or no origin → a note, and the check uses the last-fetched refs. Stalls are cut
# off by http.lowSpeed*; GIT_TERMINAL_PROMPT=0 stops a credential prompt from hanging.
fetch_origin_and_warn() {
  local label="$1" b behind
  if ! git -C "$CODE_DIR" remote get-url origin >/dev/null 2>&1; then
    echo "$label: no 'origin' remote — nothing fetched" >&2
    return 0
  fi
  if GIT_TERMINAL_PROMPT=0 git -C "$CODE_DIR" -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 fetch --quiet origin 2>/dev/null; then
    echo "$label: fetched origin"
  else
    echo "$label: WARNING — git fetch origin failed (offline?); comparing against the last-fetched origin refs" >&2
  fi
  for b in planning main; do
    git -C "$CODE_DIR" rev-parse --verify --quiet "refs/remotes/origin/$b" >/dev/null || continue
    behind="$(git -C "$CODE_DIR" rev-list --count "$b..origin/$b" 2>/dev/null || echo 0)"
    if [ "${behind:-0}" -gt 0 ]; then
      echo "$label: WARNING — local $b is $behind commit(s) BEHIND origin/$b (L-014). Look first:" >&2
      echo "    git log --oneline $b..origin/$b     then merge it in before you rely on $b" >&2
    fi
  done
}

cmd_save() {
  local message="${1:-}"
  if [ -z "$message" ]; then
    echo 'plan save: needs a message, e.g. ./plan save "DEC-035"' >&2
    exit 1
  fi

  find_worktrees
  local here
  here="$(git rev-parse --show-toplevel)"

  if [ "$here" != "$PLANNING_DIR" ]; then
    echo "plan save: run this from the planning worktree ($PLANNING_DIR), not $here" >&2
    exit 1
  fi
  fetch_origin_and_warn "plan save"

  # req-100 (R2): NOW.md exceeding its own ≤N-line rule is the one drift that is
  # always the author's to fix in the SAME edit — so block it BEFORE the commit
  # instead of surfacing it after (the post-commit report below just defers the
  # trim to next pass; hence 10+ historical "trim NOW" commits). Refuse before
  # `git add -A` so nothing is staged and the working tree is left untouched.
  # `wc -l` on the working tree matches check_handoff's git-object line_count
  # (both count newlines); the limit comes from check_handoff, never duplicated.
  local now_md="$PLANNING_DIR/handoff/NOW.md"
  if [ -f "$now_md" ]; then
    local now_lines now_limit
    now_lines="$(wc -l < "$now_md" | tr -d ' ')"
    now_limit="$(now_md_limit "$PLANNING_DIR/scripts")"
    if [ "$now_lines" -gt "$now_limit" ]; then
      echo "plan save: refusing — handoff/NOW.md is $now_lines lines, over its own ≤$now_limit-line rule. Trim it, then save." >&2
      exit 1
    fi
  fi

  git add -A

  local staged
  staged="$(git diff --cached --name-only)"

  if [ -z "$staged" ]; then
    echo "plan save: nothing to commit"
    exit 0
  fi

  local outside
  outside="$(printf '%s\n' "$staged" | grep -v '^handoff/' || true)"

  if [ -n "$outside" ]; then
    git reset >/dev/null
    echo "plan save: refusing — staged changes outside handoff/:" >&2
    printf '%s\n' "$outside" | sed 's/^/  /' >&2
    exit 1
  fi

  HANDOFF=1 git commit -m "$message" >/dev/null
  echo "plan save: committed ($(git rev-parse --short HEAD)) $message"

  # req-46 #1: surface handoff drift here, one step before publish — publish
  # already warns (req-34), but by then the drift has landed on main and costs a
  # trim-and-republish. save runs from the planning worktree on every doc change,
  # so it's the earliest honest place to catch e.g. NOW.md exceeding its own
  # ≤50-line rule. NON-BLOCKING: mirrors publish's decision (a stale line number
  # must not block a save) — the commit above already succeeded. check_handoff
  # reads git objects at HEAD (the commit just made), never the working tree.
  local save_drift
  save_drift="$(python3 "$PLANNING_DIR/scripts/check_handoff.py" --repo "$PLANNING_DIR")" || true
  if [ -n "$save_drift" ]; then
    echo "plan save: handoff drift — fix before publish (non-blocking):" >&2
    printf '%s\n' "$save_drift" | sed 's/^/  /' >&2
  fi
}

cmd_publish() {
  # req-46 #2: opt-in --push. Default stays no-push (DEC-008: standalone publish
  # and the push to origin are deliberately separate). --push is the convenience
  # for the doc-only cycle that always ended with a manual `git push origin main
  # planning`. Parsed before any refusal so a refusal exits without pushing.
  local do_push=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --push) do_push=1 ;;
      *) echo "plan publish: unknown argument '$1' (only --push)" >&2; exit 1 ;;
    esac
    shift
  done

  find_worktrees

  local code_branch
  code_branch="$(git -C "$CODE_DIR" rev-parse --abbrev-ref HEAD)"
  if [ "$code_branch" != "main" ]; then
    echo "plan publish: refusing — code worktree is on '$code_branch', not main. Claude Code may be mid-task." >&2
    exit 1
  fi

  if [ -n "$(git -C "$CODE_DIR" status --porcelain)" ]; then
    echo "plan publish: refusing — code worktree has uncommitted changes." >&2
    exit 1
  fi

  if [ -n "$(git -C "$PLANNING_DIR" status --porcelain)" ]; then
    echo "plan publish: refusing — planning worktree has unsaved edits. Run ./plan save first." >&2
    exit 1
  fi

  # req-72: main must be green before we publish onto it. Unlike the handoff
  # drift check below — a warning, because a stale line number shouldn't block
  # a publish (req-34) — a red suite is a real breakage, so this refuses. The
  # gate is ./check; its explicit WORKOUT_SKIP_CHECK=1 bypass flows
  # through here and echoes, so a skip is never silent (req-72 criterion 3).
  if ! ( cd "$CODE_DIR" && ./check ); then
    echo "plan publish: refusing — the test gate (./check) failed on $CODE_DIR." >&2
    echo "plan publish: fix the suite, or bypass explicitly:" >&2
    echo "  WORKOUT_SKIP_CHECK=1 ./plan publish" >&2
    exit 1
  fi

  local before
  before="$(git -C "$CODE_DIR" rev-parse HEAD)"

  git -C "$CODE_DIR" merge planning --no-edit >/dev/null

  local moved
  moved="$(git -C "$CODE_DIR" log --oneline "$before"..HEAD)"

  if [ -z "$moved" ]; then
    echo "plan publish: main already up to date with planning"
  else
    echo "plan publish: merged —"
    printf '%s\n' "$moved" | sed 's/^/  /'
  fi

  # req-34: a warning, not a refusal — this is the moment handoff/ becomes
  # truth for Claude Code, so it's the right place to notice drift, but a
  # publish blocked by a stale line number is a tool that gets bypassed.
  local drift_output
  drift_output="$(python3 "$CODE_DIR/scripts/check_handoff.py" --repo "$CODE_DIR")" || true
  if [ -n "$drift_output" ]; then
    echo "plan publish: handoff drift found (published anyway) —"
    printf '%s\n' "$drift_output" | sed 's/^/  /'
  fi

  # req-153: advance planning to main so the planning worktree never drifts.
  # The planning->main merge above makes planning an ancestor of main, so this
  # is a clean fast-forward with no merge commit; nothing new -> "Already up to
  # date." (exit 0). Runs locally where git in the planning worktree works; the
  # cloud sandbox never runs publish, so no cloud-side variant. If it ever
  # refuses (planning somehow not an ancestor of main), the main merge has
  # already landed — the important half — so we warn and still succeed, never
  # leaving main half-published (mirrors the check_handoff drift precedent).
  if git -C "$PLANNING_DIR" merge --ff-only main >/dev/null 2>&1; then
    echo "plan publish: planning advanced to main"
  else
    echo "plan publish: WARNING — could not fast-forward planning to main (main merge is done; planning left as-is). Investigate: planning is not an ancestor of main." >&2
  fi

  # req-46 #2: only reached on a successful publish — every refusal above exits
  # non-zero before here, so --push never fires after a refusal or error.
  if [ -n "$do_push" ]; then
    echo "plan publish: --push — pushing main and planning to origin"
    git -C "$CODE_DIR" push origin main planning
  fi
}

# req-100 (R1): the guard the Planner runs right before handing a req to Builder.
# It sends nothing (SendMessage is a Claude tool, not a shell command) — it
# verifies the publish receipt and prints the ping to paste. Read-only and safe,
# like `plan status`: no commits, merges, or push. This is the line that would
# have stopped R1 — a spec announced as "on main" while still unpublished on
# planning (L-019).
cmd_ping() {
  local arg="${1:-}"
  if [ -z "$arg" ]; then
    echo 'plan ping: needs a requirement, e.g. ./plan ping req-99' >&2
    exit 1
  fi
  local n reqid
  n="${arg#req-}"
  if ! [[ "$n" =~ ^[0-9]+$ ]]; then
    echo "plan ping: '$arg' is not a requirement id (expected req-N or N)" >&2
    exit 1
  fi
  reqid="req-$n"

  find_worktrees

  # Resolve the requirement doc exactly as closeout does — file form first,
  # folder/README second — from the planning worktree, then derive its
  # repo-relative path for the on-main check.
  local doc="" f
  for f in "$PLANNING_DIR"/handoff/work/"$reqid"-*.md; do
    [ -e "$f" ] && { doc="$f"; break; }
  done
  if [ -z "$doc" ]; then
    for f in "$PLANNING_DIR"/handoff/work/"$reqid"-*/README.md; do
      [ -e "$f" ] && { doc="$f"; break; }
    done
  fi
  if [ -z "$doc" ]; then
    echo "plan ping: refusing — no requirement doc handoff/work/$reqid-*.md in $PLANNING_DIR" >&2
    exit 1
  fi
  local relpath="${doc#"$PLANNING_DIR"/}"

  # Refuse unless the work is genuinely on main: the doc is committed on main AND
  # planning is fully published (main..planning empty — the same signal plan
  # status prints as "fully published"). Either alone missing means Builder would
  # be pointed at a spec it cannot read.
  local reasons=()
  if ! git -C "$CODE_DIR" cat-file -e "main:$relpath" 2>/dev/null; then
    reasons+=("the requirement doc ($relpath) is not on main yet")
  fi
  local unpublished n_unpub
  unpublished="$(git -C "$CODE_DIR" log --oneline main..planning)"
  if [ -n "$unpublished" ]; then
    n_unpub="$(printf '%s\n' "$unpublished" | wc -l | tr -d ' ')"
    reasons+=("$n_unpub planning commit(s) not on main")
  fi
  if [ "${#reasons[@]}" -gt 0 ]; then
    echo "plan ping: refusing to hand off $reqid —" >&2
    printf '  - %s\n' "${reasons[@]}" >&2
    echo "plan ping: publish first — ./plan publish" >&2
    exit 1
  fi

  # Receipt verified — print the ready-to-paste ping (Planner drops it into
  # SendMessage). Shape mirrors PLANNING.md's handover section.
  cat <<EOF
plan ping: $reqid is on main and planning is fully published — ready to hand off.

Paste to Builder via SendMessage:
────────────────────────────────────────
New req to build: $reqid. Full spec + acceptance criteria: $relpath (on main).

Branch $reqid, run ./check, write reports/$reqid.md, report back ready-to-look-at
(do NOT merge), in this shape:
  1  what it does            2–3 plain sentences
  2  what to test            numbered, each answerable yes or no
  3  what you couldn't       anything needing a browser, a real device, or a
     verify yourself         judgement about how it feels
────────────────────────────────────────
EOF
}

cmd_next() {
  find_worktrees

  local code_branch
  code_branch="$(git -C "$CODE_DIR" rev-parse --abbrev-ref HEAD)"
  local code_dirty=""
  [ -n "$(git -C "$CODE_DIR" status --porcelain)" ] && code_dirty=1

  # Same order as cmd_publish's checks, so the two commands never disagree
  # about what's blocking. With two conditions true at once, whichever check
  # runs first is the one reported.

  if [ "$code_branch" != "main" ]; then
    if [ -n "$code_dirty" ]; then
      echo "  code worktree is on $code_branch with uncommitted changes"
    else
      echo "  code worktree is on $code_branch"
    fi
    echo "  ->  nothing — Claude Code is mid-task. Wait, or commit that branch first."
    return 0
  fi

  if [ -n "$code_dirty" ]; then
    echo "  code worktree (main) has uncommitted changes"
    echo "  ->  nothing — commit or stash those changes first."
    return 0
  fi

  if [ -n "$(git -C "$PLANNING_DIR" status --porcelain)" ]; then
    echo "  planning has unsaved edits"
    echo "  ->  cd $PLANNING_DIR && $CODE_DIR/plan save \"message\""
    return 0
  fi

  local unpublished
  unpublished="$(git -C "$CODE_DIR" log --oneline main..planning)"
  if [ -n "$unpublished" ]; then
    local n
    n="$(printf '%s\n' "$unpublished" | wc -l | tr -d ' ')"
    echo "  $n planning commit(s) not on main; code worktree clean on main"
    echo "  ->  ./plan publish"
    if claude_code_running; then
      echo "      a Claude Code session is running — safe only if it is idle."
      echo "      an audit or a build reads handoff/, and publish rewrites it mid-read."
    fi
    return 0
  fi

  echo "  both worktrees clean, planning fully published"
  echo "  ->  nothing pending. Pick a READY requirement from handoff/NOW.md."
}

cmd_status() {
  find_worktrees
  fetch_origin_and_warn "plan status"

  local code_branch code_dirty planning_dirty unpublished
  code_branch="$(git -C "$CODE_DIR" rev-parse --abbrev-ref HEAD)"

  if [ -n "$(git -C "$CODE_DIR" status --porcelain)" ]; then
    code_dirty="$(git -C "$CODE_DIR" status --porcelain | wc -l | tr -d ' ') files changed"
  else
    code_dirty="clean"
  fi

  if [ -n "$(git -C "$PLANNING_DIR" status --porcelain)" ]; then
    planning_dirty="$(git -C "$PLANNING_DIR" status --porcelain | wc -l | tr -d ' ') files changed"
  else
    planning_dirty="clean"
  fi

  unpublished="$(git -C "$CODE_DIR" log --oneline main..planning)"

  # req-34: every Status: line against git, BACKLOG.md's index against the
  # tier files' own headings, every size claim against a real wc -l — folded
  # in here rather than a separate `plan check`, since the failure mode this
  # fixes is nobody running the check at all.
  local drift_output drift_failed=""
  if drift_output="$(python3 "$CODE_DIR/scripts/check_handoff.py" --repo "$CODE_DIR")"; then
    :
  else
    drift_failed=1
  fi

  if [ "$code_branch" = "main" ] && [ "$code_dirty" = "clean" ] && [ "$planning_dirty" = "clean" ] \
     && [ -z "$unpublished" ] && [ -z "$drift_output" ]; then
    echo "plan status: planning is fully merged, both worktrees clean."
    return 0
  fi

  echo "code worktree      $code_branch, $code_dirty"
  echo "planning worktree  planning, $planning_dirty"
  if [ -z "$unpublished" ]; then
    echo "unpublished        none"
  else
    local n
    n="$(printf '%s\n' "$unpublished" | wc -l | tr -d ' ')"
    echo "unpublished        $n commit(s) on planning not in main"
    printf '%s\n' "$unpublished" | sed 's/^/                     /'
  fi

  if [ -n "$drift_output" ]; then
    echo "handoff drift:"
    printf '%s\n' "$drift_output" | sed 's/^/  /'
  fi

  [ -z "$drift_failed" ]
}

cmd_sync() {
  find_worktrees

  local unpublished stale_code

  unpublished="$(git -C "$CODE_DIR" log --oneline main..planning)"
  stale_code="$(git -C "$CODE_DIR" log --oneline planning..main)"

  if [ -z "$unpublished" ] && [ -z "$stale_code" ]; then
    echo "plan sync: planning and main match exactly, both directions."
    return 0
  fi

  if [ -z "$unpublished" ]; then
    echo "unpublished planning (main..planning)   none — handoff is fully published"
  else
    local n
    n="$(printf '%s\n' "$unpublished" | wc -l | tr -d ' ')"
    echo "unpublished planning (main..planning)   $n commit(s)"
    echo "  ->  ./plan publish"
  fi

  if [ -z "$stale_code" ]; then
    echo "stale planning code (planning..main)   none — its checkout matches main"
  else
    local n2
    n2="$(printf '%s\n' "$stale_code" | wc -l | tr -d ' ')"
    echo "stale planning code (planning..main)   $n2 commit(s) not in the planning worktree"
    echo "  the planning session's own \"rescan the code\" step reads that checkout —"
    echo "  a requirement written now can describe code that's already moved."
    echo "  read-only report. This does not merge main into planning."
  fi
}

# req-138: the close-out was a fixed sequence run by hand, and by hand it
# failed the same ways every time — a stale .git/index.lock blocking the
# checkout, the doc Status flipped to "merged" before the merge actually
# landed (drift), the block retyped slightly differently each time. This makes
# it one deterministic command. It replaces the manual block in
# rules/CLOSEOUT.md; scope is merge + status-flip + publish + push + cleanup,
# NOT the DEC-/L-/NOW.md/SHIPPED.md recording (that stays planning's own pass).
#
# Re-runnable: if req-N is already on main, the merge is skipped and it just
# reconciles the doc + publishes + pushes.
flip_status() {
  # Replace the first **Status: ...** bold span in $1 with the exact text $2,
  # keeping everything after it. A Python one-liner rather than sed: the
  # replacement carries backticks and an em-dash, and the match spans possible
  # line wraps — re.subn with a function replacement sidesteps every quoting
  # and backreference trap sed would introduce.
  python3 - "$1" "$2" <<'PY'
import re, sys
path, newtag = sys.argv[1], sys.argv[2]
with open(path, encoding="utf-8") as fh:
    text = fh.read()
new, count = re.subn(r"\*\*Status:.*?\*\*", lambda m: newtag, text, count=1, flags=re.S)
if count == 0:
    sys.stderr.write(f"plan closeout: no **Status: ...** span found in {path}\n")
    sys.exit(1)
with open(path, "w", encoding="utf-8") as fh:
    fh.write(new)
PY
}

# req-90: the two mechanical ledger edits that followed every closeout by hand
# (and went wrong twice this session — NOW hit 51 lines once, a doubled req-84/85
# block once). STUB + RANGE ONLY: the SHIPPED substance and the "Building:" marker
# stay the author's (printed as reminders in step 7). Both edits are idempotent —
# a re-run, or an entry the author has since filled, is left untouched, never
# doubled — so a closeout re-run is safe.

# Append a "## req-N — <title>  (merged <date>)" heading + a one-line placeholder
# to SHIPPED.md, UNLESS an entry for req-N is already there. The guard both makes
# re-runs idempotent and refuses to clobber prose the author has since written
# under that heading (the append is the boilerplate; the paragraph is the signal).
append_shipped_stub() {
  local path="$1" reqid="$2" title="$3" adate="$4"
  if grep -Eq "^## ${reqid} " "$path"; then
    echo "plan closeout: SHIPPED.md — a ${reqid} entry already exists; left untouched."
    return 0
  fi
  # Two spaces before "(merged …)" to match the existing entries' heading style.
  printf '\n## %s — %s  (merged %s)\n\n_Stub — Planner: one paragraph (what changed, merge commit, gate result), then delete this line._\n' \
    "$reqid" "$title" "$adate" >> "$path"
  echo "plan closeout: SHIPPED.md — appended a ${reqid} stub (fill in the substance)."
}

# Bump NOW.md's first "**Shipped: … **" span to include req-N: extend the final
# range in place (…–(N-1) -> …–N, or a bare req-(N-1) -> req-(N-1)–N) when N abuts
# it, else append ", req-N". Idempotent: if N is already covered by any span, the
# file is untouched. Prints one word (extended|appended|unchanged) on success; the
# span is a single line, so this never adds a line (the ≤50 rule is enforced by the
# caller's line-count warning).
bump_now_range() {
  python3 - "$1" "$2" <<'PY'
import re, sys
path, n = sys.argv[1], int(sys.argv[2])
with open(path, encoding="utf-8") as fh:
    text = fh.read()

m = re.search(r"\*\*Shipped:(.*?)\*\*", text, flags=re.S)
if not m:
    sys.stderr.write("plan closeout: NOW.md — no '**Shipped: …**' span found.\n")
    sys.exit(2)

body = m.group(1)
DASH = "–"  # en-dash, as the ranges are written (req-33–89)
tok = re.compile(r"req-0*(\d+)(?:" + DASH + r"0*(\d+))?")
matches = list(tok.finditer(body))
spans = [(int(a.group(1)), int(a.group(2)) if a.group(2) else int(a.group(1))) for a in matches]

if any(lo <= n <= hi for lo, hi in spans):
    print("unchanged")  # already covered — leave the span alone
    sys.exit(0)

last = matches[-1]
lo, hi = spans[-1]
if n == hi + 1:
    new_body = body[:last.start()] + "req-%d%s%d" % (lo, DASH, n) + body[last.end():]
    result = "extended"
else:
    new_body = body + ", req-%d" % n
    result = "appended"

with open(path, "w", encoding="utf-8") as fh:
    fh.write(text[:m.start(1)] + new_body + text[m.end(1):])
print(result)
PY
}

# req-129 (DEC-057 / L-023): the independent-reviewer trigger comes from the
# FILES a req touches, not its Gate tag. Given a merge commit, print a warning
# (stdout; the caller routes it) when its diff touches a trigger path and the
# merged `reports/<reqid>.md` names no reviewer. Prints nothing otherwise.
# Non-blocking by design — it is a reminder, never a refusal.
#   trigger paths: src/ store*, model, storage, progress, workout-log, and the
#   migration/load path (migrat*, load*, exchange, import-backup); *.test.js
#   files are excluded — a test edit changes no stored data or prefill.
#   reviewer: the report matches `reviewer` case-insensitively (which covers
#   "Reviewer" and "independent reviewer", the req-129 wording).
REVIEWER_TRIGGER_RE='^src/(.*/)?(store[^/]*|model|storage|progress|workout-log|migrat[^/]*|load[^/]*|exchange|import-backup)\.(js|jsx|mjs)$'

reviewer_warning() {
  local code_dir="$1" merge="$2" reqid="$3" touched report
  touched="$(git -C "$code_dir" diff --name-only "$merge^1" "$merge" 2>/dev/null \
    | grep -Ev '\.test\.(js|jsx|mjs)$' | grep -E "$REVIEWER_TRIGGER_RE" || true)"
  [ -n "$touched" ] || return 0
  report="$(git -C "$code_dir" show "$merge:reports/$reqid.md" 2>/dev/null || true)"
  if [ -n "$report" ] && grep -qi 'reviewer' <<<"$report"; then
    return 0
  fi
  local why="names no independent reviewer"
  [ -n "$report" ] || why="is missing, so names no independent reviewer"
  echo "plan closeout: WARNING — $reqid touches DEC-057 trigger path(s) but reports/$reqid.md $why:"
  printf '%s\n' "$touched" | sed 's/^/  /'
  echo "  (DEC-057: the reviewer comes BEFORE merge. Not blocking — record why none ran, or get one now.)"
}

# req-166 (DEC-057 §1, DEC-085 §6) — the reviewer check BEFORE the merge. Prints the
# trigger files (tests excluded) that `main...<branch>` touches; empty = no reviewer needed.
reviewer_trigger_files() {
  local code_dir="$1" branch="$2"
  git -C "$code_dir" diff --name-only "main...$branch" 2>/dev/null \
    | grep -Ev '\.test\.(js|jsx|mjs)$' | grep -E "$REVIEWER_TRIGGER_RE" || true
}

# The req's SHIPPED.md entry (its "## req-N " heading up to the next "## "), recorded by
# the recording pass before closeout (CLOSEOUT.md §Preconditions).
shipped_entry() {
  local shipped="$1" reqid="$2"
  [ -f "$shipped" ] || return 0
  awk -v h="## ${reqid} " 'index($0, h) == 1 { on = 1; print; next } on && /^## / { exit } on { print }' "$shipped"
}

# 0 when the entry's gate line names a reviewer: "reviewer" (any case) from the entry's
# first "Gate" onward — DEC-057 §4's "the gate line … names the reviewer".
shipped_names_reviewer() {
  local entry
  entry="$(shipped_entry "$1" "$2")"
  [ -n "$entry" ] || return 1
  # The --no-reviewer note (below) mentions "reviewer" too; it is not a named reviewer.
  printf '%s\n' "$entry" | awk '/Gate/ { on = 1 } on' | grep -v '^No independent reviewer (`plan closeout --no-reviewer`)' | grep -qi 'reviewer'
}

# `--no-reviewer "<reason>"`: the reason is recorded in the req's SHIPPED entry (appended
# to it, or to the stub closeout writes). Idempotent: the same note is not added twice.
append_no_reviewer_note() {
  local shipped="$1" reqid="$2" reason="$3"
  local note="No independent reviewer (\`plan closeout --no-reviewer\`): ${reason}"
  if shipped_entry "$shipped" "$reqid" | grep -qF "$note"; then
    return 0
  fi
  python3 - "$shipped" "$reqid" "$note" <<'PY'
import sys
path, reqid, note = sys.argv[1], sys.argv[2], sys.argv[3]
lines = open(path, encoding="utf-8").read().split("\n")
start = next(i for i, l in enumerate(lines) if l.startswith(f"## {reqid} "))
end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
while end > start + 1 and not lines[end - 1].strip():
    end -= 1
lines[end:end] = ["", note]
open(path, "w", encoding="utf-8").write("\n".join(lines))
PY
  echo "plan closeout: SHIPPED.md — recorded the --no-reviewer reason under ${reqid}."
}

cmd_closeout() {
  # req-166 — `--no-reviewer "<reason>"` may come before or after req-N.
  local arg="" no_reviewer="" no_reviewer_set=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --no-reviewer)
        if [ -z "${2:-}" ]; then
          echo 'plan closeout: --no-reviewer needs a reason, e.g. --no-reviewer "docs-only; no trigger code changed"' >&2
          exit 1
        fi
        no_reviewer="$2"; no_reviewer_set=1; shift 2 ;;
      --no-reviewer=*)
        no_reviewer="${1#--no-reviewer=}"; no_reviewer_set=1; shift
        if [ -z "$no_reviewer" ]; then echo 'plan closeout: --no-reviewer needs a reason' >&2; exit 1; fi ;;
      *) [ -z "$arg" ] && arg="$1" || { echo "plan closeout: unexpected argument '$1'" >&2; exit 1; }; shift ;;
    esac
  done
  if [ -z "$arg" ]; then
    echo 'plan closeout: needs a requirement, e.g. ./plan closeout req-138' >&2
    exit 1
  fi
  local n reqid
  n="${arg#req-}"
  if ! [[ "$n" =~ ^[0-9]+$ ]]; then
    echo "plan closeout: '$arg' is not a requirement id (expected req-N or N)" >&2
    exit 1
  fi
  reqid="req-$n"

  find_worktrees

  # 1. Stale-lock guard, FIRST — a cloud session may have left a lock that
  # blocks the checkout. Harmless if absent. This is the line that always got
  # forgotten by hand, so it is line 1 here on purpose (CLOSEOUT.md's own note).
  local code_gitdir
  code_gitdir="$(git -C "$CODE_DIR" rev-parse --absolute-git-dir)"
  rm -f "$code_gitdir/index.lock"

  # Locate the requirement doc in the PLANNING worktree: handoff/ is authored
  # there, and the status-flip has to land on the planning branch for
  # ./plan save to commit it. File form first, folder/README second.
  local doc="" f
  for f in "$PLANNING_DIR"/handoff/work/"$reqid"-*.md; do
    [ -e "$f" ] && { doc="$f"; break; }
  done
  if [ -z "$doc" ]; then
    for f in "$PLANNING_DIR"/handoff/work/"$reqid"-*/README.md; do
      [ -e "$f" ] && { doc="$f"; break; }
    done
  fi

  # Resolve the branch to close out (req-146): bare `req-N` if it exists, else
  # the single local `req-N-<slug>` branch — CC names branches either form
  # (req-139 was `req-139-classify-tag-built-not-merged`). More than one match
  # is ambiguous and refused below (never guess which to merge); zero matches is
  # the re-run case, where the branch is already merged and gone. The
  # for-each-ref patterns are exact: `req-146-*` matches `req-146-slug` but the
  # bare `req-146` matches neither `req-1460` nor `req-146x` (verified).
  local -a branches=()
  local b
  while IFS= read -r b; do
    [ -n "$b" ] && branches+=("$b")
  done < <(git -C "$CODE_DIR" for-each-ref --format='%(refname:short)' \
             "refs/heads/$reqid" "refs/heads/$reqid-*")

  local branch="" branch_exists="" ambiguous=""
  if [ "${#branches[@]}" -gt 1 ]; then
    ambiguous=1
  elif [ "${#branches[@]}" -eq 1 ]; then
    branch="${branches[0]}"
    branch_exists=1
  fi

  # Merge state. "Already merged" is either a real `Merge branch 'req-N'` or
  # `Merge branch 'req-N-<slug>'` commit on main (the grep matches both forms,
  # req-146), or the branch being an ancestor of main — the re-run case, where
  # the branch may already be gone.
  local merge_commit=""
  merge_commit="$(git -C "$CODE_DIR" log main --merges --format=%H -E --grep="^Merge branch '$reqid(-.*)?'$" -1 2>/dev/null || true)"
  local already_merged=""
  if [ -n "$merge_commit" ]; then
    already_merged=1
  elif [ -n "$branch_exists" ] && git -C "$CODE_DIR" merge-base --is-ancestor "$branch" main 2>/dev/null; then
    already_merged=1
  fi

  # 2. Refusals (spec step 2). The ambiguity refusal comes before the
  # no-branch one: on ambiguity `branch_exists` is empty, so the no-branch
  # refusal would otherwise fire with the wrong message.
  if [ -z "$doc" ]; then
    echo "plan closeout: refusing — no requirement doc handoff/work/$reqid-*.md in $PLANNING_DIR" >&2
    exit 1
  fi
  if [ -n "$ambiguous" ]; then
    echo "plan closeout: refusing — more than one branch matches '$reqid'; rename or delete all but one:" >&2
    printf '  %s\n' "${branches[@]}" >&2
    exit 1
  fi
  if [ -z "$branch_exists" ] && [ -z "$already_merged" ]; then
    echo "plan closeout: refusing — no branch '$reqid', and it isn't on main; nothing to close out." >&2
    exit 1
  fi
  if [ -n "$(git -C "$CODE_DIR" status --porcelain)" ]; then
    echo "plan closeout: refusing — code worktree ($CODE_DIR) has uncommitted changes." >&2
    exit 1
  fi

  # 2b. req-166 (DEC-057 §1) — the reviewer check, BEFORE anything is merged. The diff
  # touches a trigger file and the req's SHIPPED entry names no reviewer on its gate line
  # → refuse, unless `--no-reviewer "<reason>"` (recorded in SHIPPED below). A re-run of
  # an already-merged req only warns (step 4c): the merge has landed, and refusing would
  # block the recovery the re-run exists for.
  local shipped_path="$PLANNING_DIR/handoff/log/SHIPPED.md" triggers=""
  if [ -z "$already_merged" ]; then
    triggers="$(reviewer_trigger_files "$CODE_DIR" "$branch")"
    if [ -n "$triggers" ] && ! shipped_names_reviewer "$shipped_path" "$reqid" && [ -z "$no_reviewer_set" ]; then
      echo "plan closeout: refusing — $branch touches DEC-057 trigger file(s) and the $reqid SHIPPED entry names no reviewer:" >&2
      printf '%s\n' "$triggers" | sed 's/^/  /' >&2
      echo "  Get the independent review, and name it on the SHIPPED gate line (\"… Gate: … independent reviewer …\"), or" >&2
      echo "  close out anyway with the reason recorded:  ./plan closeout $reqid --no-reviewer \"<why no reviewer>\"" >&2
      echo "  Nothing was merged." >&2
      exit 1
    fi
    if [ -n "$triggers" ] && [ -n "$no_reviewer_set" ]; then
      echo "plan closeout: no reviewer, by choice — reason: $no_reviewer"
    fi
  fi

  # Capture the branch's commit range for the status line. In the normal path
  # this must be read BEFORE the merge (main..req-N is empty once merged); on
  # re-run it comes from the merge commit's two parents.
  local -a commits=()
  local h
  if [ -z "$already_merged" ]; then
    while IFS= read -r h; do [ -n "$h" ] && commits+=("$h"); done \
      < <(git -C "$CODE_DIR" log "main..$branch" --format=%h)
  elif [ -n "$merge_commit" ]; then
    while IFS= read -r h; do [ -n "$h" ] && commits+=("$h"); done \
      < <(git -C "$CODE_DIR" log "$merge_commit^1..$merge_commit^2" --format=%h)
  fi

  # 3. Merge (skip if already on main).
  git -C "$CODE_DIR" checkout main >/dev/null 2>&1
  if [ -z "$already_merged" ]; then
    echo "plan closeout: merging $branch into main (--no-ff)"
    git -C "$CODE_DIR" merge --no-ff "$branch" -m "Merge branch '$branch'"
    merge_commit="$(git -C "$CODE_DIR" rev-parse HEAD)"
  else
    echo "plan closeout: $reqid is already on main — skipping merge, reconciling docs."
  fi

  # 4. Flip the doc Status — ONLY now, with the merge already an ancestor of
  # main, so the doc never claims "merged" before git agrees (criterion 3).
  if [ "${#commits[@]}" -gt 0 ]; then
    local first last count today word status_line
    last="${commits[0]}"                        # git log prints newest first
    first="${commits[$(( ${#commits[@]} - 1 ))]}"
    count="${#commits[@]}"
    today="$(date +%F)"
    word="commits"; [ "$count" -eq 1 ] && word="commit"
    status_line="**Status: BUILT AND MERGED, ${today} — branch \`${reqid}\` (\`${first}\`…\`${last}\`, ${count} ${word}).**"
    flip_status "$doc" "$status_line"
    echo "plan closeout: flipped $(basename "$doc") -> BUILT AND MERGED (${first}…${last}, ${count} ${word})"
  else
    echo "plan closeout: WARNING — could not compute the commit range; leaving the doc Status unchanged." >&2
  fi

  # 4b. req-90: the two mechanical ledger edits, done BEFORE the save below so they
  # ride the same publish. Title from the doc's first `# ` heading (minus the
  # `req-N —` prefix); date is the closeout date. Both writes are idempotent and
  # non-fatal — a failure warns and leaves the closeout to publish what it has,
  # never aborting after the merge already landed.
  local co_title co_date shipped now now_lines bump_out
  co_title="$(grep -m1 '^# ' "$doc" | sed -E 's/^# +//; s/^req-[0-9]+ *[—-] *//')"
  co_date="$(date +%F)"
  shipped="$PLANNING_DIR/handoff/log/SHIPPED.md"
  now="$PLANNING_DIR/handoff/NOW.md"

  if [ -f "$shipped" ]; then
    append_shipped_stub "$shipped" "$reqid" "$co_title" "$co_date" \
      || echo "plan closeout: WARNING — could not append the SHIPPED stub; add it by hand." >&2
    if [ -n "$no_reviewer_set" ] && [ -n "$triggers" ]; then
      append_no_reviewer_note "$shipped" "$reqid" "$no_reviewer" \
        || echo "plan closeout: WARNING — could not record the --no-reviewer reason; add it to SHIPPED by hand." >&2
    fi
  else
    echo "plan closeout: WARNING — $shipped not found; SHIPPED stub not appended." >&2
  fi

  if [ -f "$now" ]; then
    if bump_out="$(bump_now_range "$now" "$n")"; then
      echo "plan closeout: NOW.md — shipped range ${bump_out} to include ${reqid}."
    else
      echo "plan closeout: WARNING — NOW.md shipped range not bumped; do it by hand." >&2
    fi
    now_lines="$(wc -l < "$now" | tr -d ' ')"
    if [ "$now_lines" -gt 50 ]; then
      echo "plan closeout: WARNING — NOW.md is ${now_lines} lines (> 50); trim it (the range bump adds no line, but NOW is already over)." >&2
    fi
  else
    echo "plan closeout: WARNING — $now not found; shipped range not bumped." >&2
  fi

  # 4c. req-129 (DEC-057): reviewer reminder from the merged diff's files — now only for
  # a re-run of an already-merged req (req-166: a fresh merge was checked at 2b, before
  # merging). Printed now and in the final summary. Never blocks: the merge has landed.
  local review_warn=""
  if [ -n "$merge_commit" ] && [ -n "$already_merged" ]; then
    review_warn="$(reviewer_warning "$CODE_DIR" "$merge_commit" "$reqid")"
    [ -z "$review_warn" ] || printf '%s\n' "$review_warn" >&2
  fi

  # 5. Save the flip on planning, publish planning->main (runs ./check), push
  # both branches, drop the branch. ./plan save must run from the planning
  # worktree, so it is invoked there in a subshell.
  ( cd "$PLANNING_DIR" && "$CODE_DIR/plan" save "$reqid merged" )
  "$CODE_DIR/plan" publish
  git -C "$CODE_DIR" push origin main planning
  if [ -n "$branch_exists" ]; then
    git -C "$CODE_DIR" branch -d "$branch"
  fi

  # 6.
  echo
  "$CODE_DIR/plan" status || true

  # 7. req-90: the SHIPPED heading + NOW range are now written and published by
  # steps 4b/5 above, so the "what were the steps again" copy-paste is gone. What
  # remains is the author's prose — which the tool can't know and must never
  # invent — so print only that. It is a fresh save/publish because step 5 already
  # ran (the stub is on main now; the substance replaces it next pass).
  echo
  echo "plan closeout: done — ${reqid} merged; SHIPPED stub + NOW shipped-range written and published."
  echo "Still yours (prose — a fresh save/publish, DEC-009 step 9):"
  echo "  1. SHIPPED.md — replace the ${reqid} stub line with the real entry (what changed / verified)."
  echo "  2. NOW.md — move the \"Building:\" marker off ${reqid}; add any DEC-/L- from the build."
  echo "  3. ./plan save \"$reqid ledger\"  &&  ./plan publish --push"
  if [ -n "$review_warn" ]; then
    echo
    printf '%s\n' "$review_warn"
  fi
}

# req-33: one read-only command that verifies first-machine setup and explains
# each failure, instead of a dozen manual git probes. Every invariant the README
# §Setup block establishes gets one line — `ok` or `FIX: … <what to run>` — and
# any failure makes the whole command exit non-zero. It NEVER mutates: it only
# reads config and the filesystem, so it's safe to run at any time.
#
# It deliberately does NOT reuse find_worktrees (which exit 1s on the first
# missing worktree): doctor must report ALL failures in one pass, and the
# missing-worktree case is the specific one it exists to explain (the
# two-separate-clones trap). So it re-parses `git worktree list` locally.
cmd_doctor() {
  local fail=0 pd="" cd="" path="" line

  # 1. Layout — one repo with a planning worktree and a code worktree.
  while IFS= read -r line; do
    case "$line" in
      worktree\ *)               path="${line#worktree }" ;;
      branch\ refs/heads/planning) pd="$path" ;;
      branch\ refs/heads/*)       cd="$path" ;;
    esac
  done < <(git worktree list --porcelain 2>/dev/null)

  if [ -n "$pd" ] && [ -n "$cd" ]; then
    echo "ok   layout — planning ($pd) + code ($cd) worktrees in one repo"
  elif [ -z "$pd" ]; then
    echo "FIX: layout — no 'planning' worktree in this repo. This usually means two"
    echo "     SEPARATE clones instead of one repo + two worktrees. Convert it with the"
    echo "     'Already have two separate clones?' recovery block in README.md §Setup."
    fail=1
  else
    echo "FIX: layout — found the planning worktree but no second (code) worktree."
    echo "     Re-run README §Setup step 4: git worktree add ../workout-planning planning"
    fail=1
  fi

  # 2. hooksPath — the code worktree guards handoff/ via .githooks/pre-commit.
  if [ -n "$cd" ]; then
    local hp
    hp="$(git -C "$cd" config core.hooksPath 2>/dev/null || true)"
    if [ "$hp" = ".githooks" ]; then
      echo "ok   hooks — code worktree has core.hooksPath=.githooks"
    else
      echo "FIX: hooks — code worktree core.hooksPath is '${hp:-unset}', expected .githooks."
      echo "     Run: git -C $cd config core.hooksPath .githooks   (README §Setup step 2)"
      fail=1
    fi
  fi

  # 3. Dependencies — node_modules present in the code worktree.
  if [ -n "$cd" ]; then
    if [ -d "$cd/node_modules" ]; then
      echo "ok   deps — node_modules/ present in the code worktree"
    else
      echo "FIX: deps — no node_modules/ in $cd. Run: ( cd $cd && npm install )   (§Setup step 3)"
      fail=1
    fi
  fi

  # 4. Grants — the planning session's machine-local permissions file exists AND
  #    its permissions.allow matches the canonical grant set exactly (catches
  #    content drift: a stale, narrowed, or over-broad list — DEC-028 follow-up).
  #    The canonical list below is the ten grants from README §Setup step 5
  #    (DEC-005 / DEC-026). KEEP IN SYNC WITH README §Setup step 5 — the one
  #    coupling: if the grants there change, change them here too.
  if [ -n "$pd" ]; then
    local grants_file="$pd/.claude/settings.local.json"
    if [ ! -f "$grants_file" ]; then
      echo "FIX: grants — no .claude/settings.local.json in the planning worktree ($pd)."
      echo "     Re-paste the grant block from README §Setup step 5."
      fail=1
    else
      local canonical_grants=(
        'Bash(git add:*)'
        'Bash(git commit:*)'
        'Bash(git reset:*)'
        'Bash(git restore:*)'
        'Bash(git push origin planning:*)'
        'Bash(git push origin main planning:*)'
        'Bash(../workout-codebase/plan save:*)'
        'Bash(../workout-codebase/plan status:*)'
        'Bash(../workout-codebase/plan publish:*)'
        'Bash(../workout-codebase/plan closeout:*)'
      )
      # python3 is already a dependency (scripts/check_handoff.py). Read
      # permissions.allow as JSON and diff (order-independent set comparison);
      # a malformed/unreadable file returns a PARSE line, never a stack trace.
      local grants_result
      grants_result="$(CANONICAL="$(printf '%s\n' "${canonical_grants[@]}")" python3 - "$grants_file" <<'PY'
import json, os, sys
canonical = set(os.environ["CANONICAL"].splitlines())
try:
    with open(sys.argv[1]) as f:
        data = json.load(f)
except (ValueError, OSError) as e:
    print("PARSE\t%s" % e)
    sys.exit(0)
allow = (data.get("permissions") or {}).get("allow")
if not isinstance(allow, list):
    print("PARSE\tno permissions.allow array")
    sys.exit(0)
actual = set(allow)
missing = sorted(canonical - actual)
extra = sorted(actual - canonical)
if not missing and not extra:
    print("OK\t%d" % len(canonical))
else:
    print("DRIFT\tmissing: %s\textra: %s" % (
        ", ".join(missing) or "(none)",
        ", ".join(extra) or "(none)"))
PY
)"
      local tag="${grants_result%%$'\t'*}" rest="${grants_result#*$'\t'}"
      case "$tag" in
        OK)
          echo "ok   grants — $grants_file matches all $rest canonical grants"
          ;;
        DRIFT)
          echo "FIX: grants — ${rest//$'\t'/; }"
          echo "     Re-paste the grant block from README §Setup step 5."
          fail=1
          ;;
        *)
          echo "FIX: grants — could not read permissions.allow from $grants_file: $rest"
          echo "     Re-paste the grant block from README §Setup step 5."
          fail=1
          ;;
      esac
    fi
  fi

  # 5. Git identity — real name + email, not the auto host-local fallback git
  # invents at commit time (which won't link to a GitHub account).
  local gname gemail
  gname="$(git config user.name || true)"
  gemail="$(git config user.email || true)"
  if [ -z "$gname" ] || [ -z "$gemail" ]; then
    echo "FIX: identity — user.name/user.email not both set (name='${gname}', email='${gemail}')."
    echo "     git config --global user.name '…'; git config --global user.email '…'  (§Setup step 2b)"
    fail=1
  elif [[ "$gemail" == *.local || "$gemail" == *'.(none)' ]]; then
    echo "FIX: identity — user.email '$gemail' looks auto-generated (host-local), not a real email."
    echo "     Set it: git config --global user.email 'you@example.com'   (§Setup step 2b)"
    fail=1
  else
    echo "ok   identity — user.name='$gname', user.email='$gemail'"
  fi

  # 6. End with plan status so layout + drift show in one go. Informational:
  # its exit (which can flag drift on a correctly set-up machine) does not
  # change doctor's own exit — doctor reports SETUP health, status reports drift.
  echo
  echo "doctor: setup checks done — running plan status:"
  echo
  "$0" status || true

  echo
  if [ "$fail" -ne 0 ]; then
    echo "doctor: one or more setup checks need attention (see FIX: lines above)." >&2
    exit 1
  fi
  echo "doctor: all setup checks passed."
}

# req-91: `plan preview` — DEC-041's phone-test gate as one verb. Builds the
# checked-out (or a named req-N) branch exactly as `npm run demo` does (vite
# build, base '/' with GITHUB_PAGES unset -> vite preview on :4173), then exposes
# it over the tailnet with `tailscale serve` (private, NEVER funnel — DEC-041),
# and prints the HTTPS *.ts.net URL to open on the phone. `plan preview stop`
# tears the whole thing down.
#
# Runs in the CODE worktree — it builds and serves a code branch, so it is not a
# planning-session command (the DEC-041 caveat). All git/build/serve work targets
# CODE_DIR. `npm run demo` is one foreground `vite build && vite preview`; this
# splits the two so the preview can be backgrounded (survives the command),
# tracked by pid, and torn down cleanly — same vite flags, same DEC-041 wiring.

# Resolve the branch a `req-N` arg names: the bare `req-N` if it exists, else the
# single `req-N-<slug>`. Zero or many matches is refused (never guess which to
# serve) — same shape as closeout's branch resolution.
preview_resolve_branch() {
  local n="$1" reqid="req-$1"
  local -a branches=()
  local b
  while IFS= read -r b; do
    [ -n "$b" ] && branches+=("$b")
  done < <(git -C "$CODE_DIR" for-each-ref --format='%(refname:short)' \
             "refs/heads/$reqid" "refs/heads/$reqid-*")
  if [ "${#branches[@]}" -eq 0 ]; then
    echo "plan preview: no branch '$reqid' (or '$reqid-*') to preview." >&2
    return 1
  fi
  if [ "${#branches[@]}" -gt 1 ]; then
    echo "plan preview: more than one branch matches '$reqid'; name one exactly:" >&2
    printf '  %s\n' "${branches[@]}" >&2
    return 1
  fi
  printf '%s\n' "${branches[0]}"
}

# Poll until vite preview accepts connections, or the process dies (a port clash
# under --strictPort exits it). Bounded so a stuck start never hangs the command.
preview_wait_ready() {
  local i pid
  for i in $(seq 1 30); do
    pid="$(cat "$PREVIEW_PIDFILE" 2>/dev/null || true)"
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
      return 1
    fi
    if curl -sf -o /dev/null "http://127.0.0.1:$PREVIEW_PORT/" 2>/dev/null; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

# The HTTPS URL `tailscale serve` publishes for this node = https://<MagicDNS
# name>. Read it from `tailscale status --json` (.Self.DNSName). Empty output if
# tailscale is down or the field is missing — the caller falls back to `serve
# status`.
preview_url() {
  command -v tailscale >/dev/null 2>&1 || return 0
  tailscale status --json 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    name = ((d.get("Self") or {}).get("DNSName") or "").rstrip(".")
    if name:
        print("https://" + name)
except Exception:
    pass
' 2>/dev/null || true
}

# Turn off the tailnet serve for our port. DEC-041/DEMO.md form first (surgical:
# just the :443 handler); fall back to a full reset if that form fails (e.g. a
# tailscale build without `--https=… off`). Both are no-ops when the daemon is
# down — nothing is serving in that case anyway.
preview_tailscale_off() {
  command -v tailscale >/dev/null 2>&1 || return 0
  if tailscale serve --https=443 off >/dev/null 2>&1; then
    echo "plan preview: tailscale serve on :443 turned off"
  elif tailscale serve reset >/dev/null 2>&1; then
    echo "plan preview: tailscale serve reset"
  else
    echo "plan preview: note — 'tailscale serve' teardown did not run (daemon down?); nothing serving if so." >&2
  fi
}

# Tear down everything a start put up: the tracked preview server, any straggler
# on the fixed port (so a lost pidfile never leaves :4173 occupied and a re-run
# never stacks two), and the tailnet serve. Idempotent — safe to call before a
# start and on its own via `plan preview stop`.
preview_stop() {
  local stopped=""
  if [ -f "$PREVIEW_PIDFILE" ]; then
    local pid
    pid="$(cat "$PREVIEW_PIDFILE" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      echo "plan preview: stopped preview server (pid $pid)"
      stopped=1
    fi
    rm -f "$PREVIEW_PIDFILE"
  fi
  if command -v lsof >/dev/null 2>&1; then
    local port_pids
    port_pids="$(lsof -ti "tcp:$PREVIEW_PORT" 2>/dev/null || true)"
    if [ -n "$port_pids" ]; then
      echo "$port_pids" | xargs kill 2>/dev/null || true
      echo "plan preview: freed port $PREVIEW_PORT"
      stopped=1
    fi
  fi
  preview_tailscale_off
  [ -n "$stopped" ] || echo "plan preview: no local preview server was running"
  rm -f "$PREVIEW_LOG"
}

cmd_preview() {
  local arg="${1:-}"

  # stop needs neither a worktree nor tailscale-up; handle it first so it always
  # works, from anywhere.
  if [ "$arg" = "stop" ]; then
    preview_stop
    return 0
  fi

  find_worktrees
  local here
  here="$(git rev-parse --show-toplevel)"
  if [ "$here" != "$CODE_DIR" ]; then
    echo "plan preview: run this from the code worktree ($CODE_DIR), not $here." >&2
    echo "  it builds and serves a code branch; the planning worktree is the wrong place (DEC-041)." >&2
    exit 1
  fi

  if ! command -v tailscale >/dev/null 2>&1; then
    echo "plan preview: tailscale not found on PATH — the phone-test gate needs it (DEC-041/DEMO.md)." >&2
    exit 1
  fi

  # Optional branch checkout, only on a clean tree (never clobber in-progress
  # work). No arg -> preview whatever is checked out.
  case "$arg" in
    "")
      ;;
    req-*|[0-9]*)
      local n="${arg#req-}"
      if ! [[ "$n" =~ ^[0-9]+$ ]]; then
        echo "plan preview: '$arg' is not a requirement id (expected req-N or N)" >&2
        exit 1
      fi
      if [ -n "$(git -C "$CODE_DIR" status --porcelain)" ]; then
        echo "plan preview: refusing — code worktree ($CODE_DIR) has uncommitted changes." >&2
        echo "  won't check out req-$n over in-progress work. Commit or stash first, e.g.:" >&2
        echo "    git -C \"$CODE_DIR\" stash    # re-run, then: git -C \"$CODE_DIR\" stash pop" >&2
        exit 1
      fi
      local branch
      branch="$(preview_resolve_branch "$n")" || exit 1
      if ! git -C "$CODE_DIR" checkout "$branch" >/dev/null 2>&1; then
        echo "plan preview: could not check out '$branch'." >&2
        exit 1
      fi
      echo "plan preview: checked out $branch"
      ;;
    *)
      echo "plan preview: unknown argument '$arg' (expected nothing, req-N, or stop)" >&2
      exit 1
      ;;
  esac

  local branch_now
  branch_now="$(git -C "$CODE_DIR" rev-parse --abbrev-ref HEAD)"

  # Replace cleanly: clear any previous preview before starting a new one, so two
  # servers never stack on :4173 (--strictPort would otherwise error).
  preview_stop >/dev/null 2>&1 || true

  echo "plan preview: building $branch_now (vite build, base '/', GITHUB_PAGES unset)…"
  if ! ( cd "$CODE_DIR" && env -u GITHUB_PAGES npm run build ) >/dev/null 2>&1; then
    echo "plan preview: build failed — run 'npm run build' in $CODE_DIR to see the error." >&2
    exit 1
  fi

  echo "plan preview: starting vite preview on :${PREVIEW_PORT}…"
  # exec so the tracked pid IS vite (not an npm wrapper), for a clean single-kill
  # teardown. Backgrounded and log-redirected, so it outlives this command.
  ( cd "$CODE_DIR" && exec ./node_modules/.bin/vite preview \
      --port "$PREVIEW_PORT" --strictPort --host 127.0.0.1 ) >"$PREVIEW_LOG" 2>&1 &
  echo "$!" > "$PREVIEW_PIDFILE"

  if ! preview_wait_ready; then
    echo "plan preview: preview server didn't come up — last lines of its log:" >&2
    tail -n 15 "$PREVIEW_LOG" >&2 2>/dev/null || true
    preview_stop >/dev/null 2>&1 || true
    exit 1
  fi

  # Expose over the tailnet — serve (private), NEVER funnel (DEC-041).
  if ! tailscale serve --bg "$PREVIEW_PORT" >/dev/null 2>&1; then
    echo >&2
    echo "plan preview: the build is serving locally on http://127.0.0.1:$PREVIEW_PORT," >&2
    echo "  but 'tailscale serve' failed — is tailscaled up and logged in? (check: tailscale status)" >&2
    echo "  once it is:   tailscale serve --bg $PREVIEW_PORT" >&2
    echo "  when done:    ./plan preview stop" >&2
    exit 1
  fi

  local url
  url="$(preview_url)"
  echo
  if [ -n "$url" ]; then
    echo "plan preview: $branch_now is live for the phone (open on the tailnet):"
    echo "    $url"
  else
    echo "plan preview: $branch_now is serving; open the HTTPS host shown by:"
    tailscale serve status 2>&1 | sed 's/^/    /' || true
  fi
  echo
  echo "  stop when done:  ./plan preview stop"
}

# req-159: `plan qa <ref>` — an isolated browser build of any ref on its own origin
# (L-033's by-hand recipe). All the work is scripts/qa.mjs (node builtins only): git
# archive into a temp dir, borrowed node_modules, vite build, a detached static
# server, the seed inlined into index.html. Nothing is written to either worktree, so
# it runs from the planning worktree too: it uses this checkout's qa.mjs (else the
# code worktree's, for a planning branch that predates it) and always the code
# worktree's node_modules, the one that has them. Browser-smoke it with
# `node scripts/smoke.mjs --url <url>`.
cmd_qa() {
  local self_dir qa
  self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  find_worktrees
  qa="$self_dir/scripts/qa.mjs"
  [ -f "$qa" ] || qa="$CODE_DIR/scripts/qa.mjs"
  if [ ! -f "$qa" ]; then
    echo "plan qa: no scripts/qa.mjs here or in $CODE_DIR — merge req-159 first." >&2
    exit 1
  fi
  case "${1:-}" in
    --stop|stop)
      node "$qa" stop
      ;;
    --status|status)
      node "$qa" status
      ;;
    ""|-h|--help)
      echo "usage: plan qa <ref> [--seed <file>]   |   plan qa --stop   |   plan qa --status" >&2
      exit 1
      ;;
    *)
      node "$qa" start "$@" --node-modules "$CODE_DIR/node_modules"
      ;;
  esac
}

# req-90: `_PLAN_NO_MAIN=1 source ./plan` loads the functions without dispatching,
# so the ledger helpers (append_shipped_stub / bump_now_range) can be exercised
# against fixtures by scripts/plan-ledger.test.sh. No effect on normal invocation.
if [ "${_PLAN_NO_MAIN:-}" = "1" ]; then
  return 0 2>/dev/null || exit 0
fi

case "${1:-}" in
  save)
    shift
    cmd_save "$@"
    ;;
  publish)
    shift
    cmd_publish "$@"
    ;;
  status)
    cmd_status
    ;;
  next)
    cmd_next
    ;;
  ping)
    shift
    cmd_ping "$@"
    ;;
  sync)
    cmd_sync
    ;;
  doctor)
    cmd_doctor
    ;;
  closeout)
    shift
    # closeout checks out / merges mid-run, which rewrites this very file on
    # disk (a req that touches `plan` — like req-138 itself — or a run from a
    # non-main branch). Bash reads a script file incrementally, so a file that
    # changes underfoot corrupts execution. Re-exec once from a stable temp
    # copy so the on-disk source can change freely; the copy cleans itself up.
    if [ "${_PLAN_REEXEC:-}" != "1" ]; then
      _PLAN_SELF="$(mktemp "${TMPDIR:-/tmp}/plan-closeout.XXXXXX")"
      cat "$0" > "$_PLAN_SELF"
      export _PLAN_REEXEC=1 _PLAN_SELF
      exec bash "$_PLAN_SELF" closeout "$@"
    fi
    trap 'rm -f "${_PLAN_SELF:-}"' EXIT
    cmd_closeout "$@"
    ;;
  preview)
    shift
    # Like closeout: `preview req-N` checks out a branch mid-run, which can
    # rewrite this very `plan` file on disk (req-91 itself does). Bash reads a
    # script incrementally, so re-exec once from a stable temp copy before the
    # checkout; the copy cleans itself up. The backgrounded preview server is a
    # child of the re-exec'd shell and outlives it (no huponexit in scripts).
    if [ "${_PLAN_REEXEC:-}" != "1" ]; then
      _PLAN_SELF="$(mktemp "${TMPDIR:-/tmp}/plan-preview.XXXXXX")"
      cat "$0" > "$_PLAN_SELF"
      export _PLAN_REEXEC=1 _PLAN_SELF
      exec bash "$_PLAN_SELF" preview "$@"
    fi
    trap 'rm -f "${_PLAN_SELF:-}"' EXIT
    cmd_preview "$@"
    ;;
  qa)
    shift
    cmd_qa "$@"
    ;;
  *)
    usage
    exit 0
    ;;
esac
